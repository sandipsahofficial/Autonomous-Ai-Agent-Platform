# ==============================================================================
# MESH — Agent OS: Environment Configuration Template
# Copy this file to '.env' and adjust values for your environment.
# NEVER commit real credentials or production secrets to version control.
# ==============================================================================

# --- Application Environment ---
# In development: APP_ENV=development, APP_DEBUG=true
# In production:  APP_ENV=production,  APP_DEBUG=false (enforced by startup validator)
APP_ENV=development
APP_DEBUG=true
PORT=8000
HOST=0.0.0.0

# --- Security & Authentication (Phase 5) ---
# Generate a cryptographically secure key for production:
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=mesh_insecure_development_secret_change_in_production
# Enforces mandatory Bearer token / X-API-Key authentication on all endpoints when true:
REQUIRE_AUTH=false
# Comma-separated list of allowed CORS origins. Wildcard '*' is strictly forbidden in production:
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
# In-memory sliding-window API rate limiting:
RATE_LIMIT_ENABLED=true
# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# --- Database (PostgreSQL / SQLite) ---
# For local SQLite quickstart: DATABASE_URL=sqlite:///./dev.db
# For production PostgreSQL container:
POSTGRES_USER=agent_admin
POSTGRES_PASSWORD=agent_secret_password
POSTGRES_DB=agent_platform
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://agent_admin:agent_secret_password@postgres:5432/agent_platform

# --- LLM Provider Selection ---
# Options: ollama (recommended zero-cost local) | mock (offline test) | openai | claude
LLM_PROVIDER=ollama
OPENAI_API_KEY=
CLAUDE_API_KEY=
LLM_MODEL_NAME=llama3

# --- Local Ollama Configuration ---
# In host development:   http://localhost:11434
# Inside Docker Desktop:  http://host.docker.internal:11434
# Inside Linux Docker:    http://172.17.0.1:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_NAME=llama3
LLM_TIMEOUT_SECONDS=60

# --- Autonomous Execution Bounds & Guardrails ---
MAX_REWORK_ATTEMPTS=3
MAX_STEPS=15
TOKEN_BUDGET=50000
COST_BUDGET_USD=2.00
