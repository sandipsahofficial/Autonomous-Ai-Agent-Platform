# Environment variables template for Autonomous AI Agent Platform

# --- Application Configuration ---
APP_ENV=development
APP_DEBUG=true
PORT=8000
HOST=0.0.0.0

# --- Database (PostgreSQL) ---
POSTGRES_USER=agent_admin
POSTGRES_PASSWORD=agent_secret_password
POSTGRES_DB=agent_platform
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://agent_admin:agent_secret_password@postgres:5432/agent_platform

# --- LLM Provider Settings ---
# Options: mock | openai | claude | ollama
LLM_PROVIDER=mock
OPENAI_API_KEY=
CLAUDE_API_KEY=
LLM_MODEL_NAME=llama3
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_NAME=llama3
LLM_TIMEOUT_SECONDS=60

# --- Safety & Execution Limits ---
MAX_REWORK_ATTEMPTS=3
MAX_STEPS=15
TOKEN_BUDGET=50000
COST_BUDGET_USD=2.00
